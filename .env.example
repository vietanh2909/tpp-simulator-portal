# Địa chỉ backend mà Vite proxy chuyển tiếp tới (/api và POST /callbacks/*).
# Mặc định: http://127.0.0.1:8080 (backend chỉ lắng nghe loopback).
VITE_BACKEND_URL=

# Base URL của API. Để TRỐNG: trình duyệt gọi cùng nguồn qua Vite proxy (backend cấm CORS).
VITE_API_BASE_URL=

# Gốc URL callback hiển thị cho từng dịch vụ. Để TRỐNG: dùng địa chỉ trang đang mở (window.location.origin).
# Đặt giá trị khi hệ thống ngân hàng gọi tới một địa chỉ khác (ví dụ http://192.168.1.10:5173).
VITE_CALLBACK_BASE_URL=
